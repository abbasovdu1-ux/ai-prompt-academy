# =============================================================================
# Synthecs — Environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git. Only `.env.example` is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API (REQUIRED for the prompt trainer)
# -----------------------------------------------------------------------------
# Server-side key used by the prompt trainer to call Google's Gemini API.
#
# Create it in Google AI Studio. Restrict the key to the Gemini API.
#
# NEVER expose this to the browser. Do NOT prefix with VITE_.
GEMINI_API_KEY=

# Optional stable model override.
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Node environment (optional)
# -----------------------------------------------------------------------------
# Vite sets this automatically for `dev` / `build`. Only override in
# hosting platforms that require an explicit value.
# NODE_ENV=production
