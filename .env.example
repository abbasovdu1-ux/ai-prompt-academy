# =============================================================================
# Synthecs — Environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git. Only `.env.example` is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Lovable AI Gateway (REQUIRED)
# -----------------------------------------------------------------------------
# Server-side key used by src/routes/api.improve-prompt.ts and
# src/lib/ai-gateway.server.ts to call https://ai.gateway.lovable.dev.
#
# Where to get it:
#   - On Lovable: auto-provisioned. No action needed.
#   - Self-hosting: create a workspace on lovable.dev, then in Project
#     Settings copy the LOVABLE_API_KEY, OR swap the provider in
#     src/lib/ai-gateway.server.ts for OpenAI / another OpenAI-compatible
#     endpoint and use that provider's key instead.
#
# NEVER expose this to the browser. Do NOT prefix with VITE_.
LOVABLE_API_KEY=

# -----------------------------------------------------------------------------
# Node environment (optional)
# -----------------------------------------------------------------------------
# Vite sets this automatically for `dev` / `build`. Only override in
# hosting platforms that require an explicit value.
# NODE_ENV=production
